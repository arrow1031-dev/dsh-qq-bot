{
  "name": "dsh-qq-bot",
  "version": "0.10.1",
  "description": "把 QQ 接到 DSH Agent 的插件（社区化维护）：经 NapCat / OneBot 11 收发消息，每个 QQ 会话一个 DSH Agent。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./adapter": "./lib/onebot-adapter.mjs",
    "./client": {
      "default": "./lib/client.js"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "ARCHITECTURE.md",
    "LICENSE",
    "AI-DISCLOSURE.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=22.6",
    "dsh": ">=0.2.0-rc.2"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "dsh": {
    "runtime": "host",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.2 <0.3.0"
    }
  },
  "scripts": {
    "test": "node test/run-all.mjs"
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "qq",
    "qqbot",
    "onebot",
    "onebot11",
    "napcat",
    "chatbot",
    "cordis",
    "plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arrow1031-dev/dsh-qq-bot.git"
  },
  "bugs": {
    "url": "https://github.com/arrow1031-dev/dsh-qq-bot/issues"
  },
  "homepage": "https://github.com/arrow1031-dev/dsh-qq-bot#readme",
  "author": {
    "name": "arrow1031",
    "url": "https://github.com/arrow1031"
  }
}
